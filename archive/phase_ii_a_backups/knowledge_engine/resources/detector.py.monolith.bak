from __future__ import annotations

import sqlite3
from pathlib import Path

from knowledge_engine.resources.models import ResourceGuess


DOCUMENT_EXTENSIONS = {
    ".pdf", ".epub", ".doc", ".docx", ".txt", ".md", ".rtf",
    ".odt", ".ods", ".odp", ".ppt", ".pptx", ".xls", ".xlsx",
    ".csv", ".zim",
}

IMAGE_EXTENSIONS = {
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".ico",
}

WEB_EXTENSIONS = {
    ".html", ".htm", ".css", ".js", ".json", ".png", ".jpg",
    ".jpeg", ".gif", ".svg", ".webp", ".ico",
}

SOURCE_EXTENSIONS = {
    ".py", ".c", ".cpp", ".h", ".hpp", ".java", ".js", ".ts",
    ".rs", ".go", ".sh", ".sql", ".yml", ".yaml", ".json",
}

PROJECT_MARKERS = {
    ".git", "pyproject.toml", "setup.py", "requirements.txt",
    "package.json", "Cargo.toml", "CMakeLists.txt", "Makefile",
    "pom.xml", "build.gradle",
}

WEBSITE_MARKERS = {"index.html", "index.htm"}


def clean_object_name(path: Path) -> str:
    name = path.name

    if name.lower().endswith((".html", ".htm")):
        name = Path(name).stem

    return name.replace("_", " ").replace("-", " ").strip() or path.name


def path_parts(path: Path) -> tuple[str, ...]:
    return tuple(str(part) for part in path.parts)


def find_enclosing_html_bundle(path: Path) -> Path | None:
    """
    Detect website mirror bundles like:

    afg-war-diary.html/
        afg/
        static/
        index.html

    Any file inside that folder should belong to the bundle root.
    """

    for parent in [path] + list(path.parents):
        name = parent.name.lower()

        if name.endswith((".html", ".htm")) and parent != path:
            return parent

    return None


def find_project_root_from_path(path: Path) -> Path | None:
    """
    Lightweight path-based project detector.

    This avoids filesystem scans. It only recognizes common project-root
    file names when they appear in the path.
    """

    parts = path_parts(path)

    for marker in PROJECT_MARKERS:
        if marker in parts:
            idx = parts.index(marker)
            return Path(*parts[:idx]) if idx > 0 else None

    return None


def detect_resource(row: sqlite3.Row) -> ResourceGuess:
    file_path = Path(row["file_path"])
    relative = Path(row["relative_path"])
    ext = file_path.suffix.lower()

    html_bundle = find_enclosing_html_bundle(file_path)
    if html_bundle is not None and ext in WEB_EXTENSIONS:
        return ResourceGuess(
            object_path=html_bundle,
            object_name=clean_object_name(html_bundle),
            object_type_hint="website_archive",
            primary_file_path=str(html_bundle / "index.html"),
            confidence=0.99,
            reason="resource detector: enclosing website bundle directory",
        )

    if ext in DOCUMENT_EXTENSIONS:
        return ResourceGuess(
            object_path=file_path,
            object_name=clean_object_name(file_path),
            object_type_hint="single_document",
            primary_file_path=str(file_path),
            confidence=0.90,
            reason=f"resource detector: standalone document {ext}",
        )

    project_root = find_project_root_from_path(file_path)
    if project_root is not None:
        return ResourceGuess(
            object_path=project_root,
            object_name=clean_object_name(project_root),
            object_type_hint="codebase",
            primary_file_path=None,
            confidence=0.85,
            reason="resource detector: project marker in path",
        )

    if ext in IMAGE_EXTENSIONS:
        return ResourceGuess(
            object_path=file_path,
            object_name=clean_object_name(file_path),
            object_type_hint="single_image",
            primary_file_path=str(file_path),
            confidence=0.70,
            reason=f"resource detector: standalone image {ext}",
        )

    if ext in SOURCE_EXTENSIONS and len(relative.parts) > 1:
        return ResourceGuess(
            object_path=file_path.parent,
            object_name=clean_object_name(file_path.parent),
            object_type_hint="source_collection",
            primary_file_path=None,
            confidence=0.70,
            reason="resource detector: source file grouped by parent folder",
        )

    if len(relative.parts) > 1:
        return ResourceGuess(
            object_path=file_path.parent,
            object_name=clean_object_name(file_path.parent),
            object_type_hint=None,
            primary_file_path=None,
            confidence=0.60,
            reason="fallback: grouped by parent folder",
        )

    return ResourceGuess(
        object_path=file_path,
        object_name=clean_object_name(file_path),
        object_type_hint=None,
        primary_file_path=str(file_path),
        confidence=0.50,
        reason="fallback: single loose file",
    )
