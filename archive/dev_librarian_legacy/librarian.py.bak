#!/usr/bin/env python3
"""
JARVIS Librarian - ADR-0006 Phase 1

Inventory Knowledge/, build SQLite catalog, detect duplicates,
score coverage, and identify missing knowledge areas.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import sqlite3
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Iterable


DEFAULT_KNOWLEDGE_ROOT = Path("/media/abdullah/JARVISDATA/Knowledge")
DEFAULT_DB = Path("/media/abdullah/JARVIS_RUNTIME_L/knowledge/librarian.sqlite")

SUPPORTED_EXTENSIONS = {
    ".pdf",
    ".epub",
    ".txt",
    ".md",
    ".zim",
    ".html",
    ".htm",
    ".csv",
    ".json",
    ".xml",
}


DESIRED_TOPICS = {
    "aviation": ["aircraft", "maintenance", "navigation", "regulations", "rotorcraft", "systems"],
    "computing": [
        "ai",
        "cybersecurity",
        "databases",
        "linux",
