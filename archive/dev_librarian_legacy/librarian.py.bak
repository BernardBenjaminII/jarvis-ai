        "compilers",
        "cryptography",
    ],
    "emergency": [
        "agriculture",
        "bushcraft",
        "civil_defense",
        "communications",
        "disaster_response",
        "food",
        "search_and_rescue",
        "shelter",
        "survival",
        "water",
        "wilderness",
    ],
    "engineering": [
        "civil",
        "electrical",
        "electronics",
        "manufacturing",
        "materials",
        "mechanical",
        "control_systems",
        "hydraulics",
        "thermodynamics",
        "robotics",
        "embedded_systems",
    ],
    "geography": ["geodata", "gis", "maps", "terrain", "weather"],
    "mathematics": [
        "algebra",
        "calculus",
        "discrete_math",
        "linear_algebra",
        "statistics",
        "probability",
        "optimization",
        "numerical_methods",
    ],
    "medical": [
        "anatomy",
        "community_health",
        "dentistry",
        "emergency",
        "field_medicine",
        "first_aid",
        "medications",
        "mental_health",
        "obstetrics",
