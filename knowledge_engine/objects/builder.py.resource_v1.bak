from __future__ import annotations

import hashlib
import sqlite3
import uuid
from collections import defaultdict
from dataclasses import dataclass
from pathlib import Path


DOCUMENT_EXTENSIONS = {
    ".pdf",
    ".epub",
    ".doc",
    ".docx",
    ".txt",
    ".md",
    ".rtf",
    ".odt",
    ".ods",
    ".odp",
    ".ppt",
    ".pptx",
    ".xls",
    ".xlsx",
    ".csv",
    ".zim",
}

IMAGE_EXTENSIONS = {
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".svg",
    ".ico",
}

WEB_EXTENSIONS = {
    ".html",
    ".htm",
    ".css",
    ".js",
    ".json",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".svg",
    ".webp",
    ".ico",
}

SOURCE_EXTENSIONS = {
    ".py",
    ".c",
    ".cpp",
    ".h",
    ".hpp",
    ".java",
    ".js",
    ".ts",
    ".rs",
    ".go",
    ".sh",
    ".sql",
    ".yml",
    ".yaml",
    ".json",
}

PROJECT_MARKERS = {
    ".git",
    "pyproject.toml",
    "setup.py",
    "requirements.txt",
    "package.json",
    "Cargo.toml",
    "CMakeLists.txt",
    "Makefile",
    "pom.xml",
    "build.gradle",
}

WEBSITE_MARKERS = {
    "index.html",
    "index.htm",
}

COMMON_WEB_DIRS = {
    "css",
    "js",
    "images",
    "img",
    "assets",
    "fonts",
    "static",
    "media",
}

NAVIGATION_OR_FACET_DIRS = {
    "sort",
    "category",
    "categories",
    "tag",
    "tags",
    "region",
    "date",
    "severity",
    "type",
    "affiliation",
    "author",
    "topic",
    "topics",
    "month",
    "year",
    "search",
    "page",
    "pages",
    "archive",
    "archives",
}


@dataclass(frozen=True)
class KnowledgeObject:
    object_uuid: str
    root_path: str
    object_path: str
    object_name: str
    object_type: str
    primary_file_path: str | None
    file_count: int
    total_size_bytes: int
    content_fingerprint: str
    status: str
    confidence: float
    reason: str


@dataclass(frozen=True)
class ResourceGuess:
    object_path: Path
    object_name: str
    object_type_hint: str | None
    primary_file_path: str | None
    confidence: float
    reason: str


def init_db(conn: sqlite3.Connection) -> None:
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS knowledge_objects (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            object_uuid TEXT NOT NULL UNIQUE,
            root_path TEXT NOT NULL,
            object_path TEXT NOT NULL UNIQUE,
            object_name TEXT NOT NULL,
            object_type TEXT NOT NULL,
            primary_file_path TEXT,
            file_count INTEGER NOT NULL,
            total_size_bytes INTEGER NOT NULL,
            content_fingerprint TEXT NOT NULL,
            status TEXT NOT NULL,
            confidence REAL NOT NULL,
            reason TEXT NOT NULL,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
        )
        """
    )

    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS knowledge_object_files (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            object_uuid TEXT NOT NULL,
            discovered_file_id INTEGER NOT NULL,
            file_path TEXT NOT NULL UNIQUE,
            role TEXT NOT NULL,
            FOREIGN KEY(object_uuid) REFERENCES knowledge_objects(object_uuid),
            FOREIGN KEY(discovered_file_id) REFERENCES discovered_files(id)
        )
        """
    )

    conn.execute(
        """
        CREATE INDEX IF NOT EXISTS idx_knowledge_objects_type
        ON knowledge_objects(object_type)
        """
    )

    conn.execute(
        """
        CREATE INDEX IF NOT EXISTS idx_knowledge_objects_status
        ON knowledge_objects(status)
        """
    )

    conn.execute(
        """
        CREATE INDEX IF NOT EXISTS idx_knowledge_object_files_object_uuid
        ON knowledge_object_files(object_uuid)
        """
    )

    conn.commit()


def stable_uuid(object_path: str, fingerprint: str) -> str:
    seed = f"{object_path}|{fingerprint}"
    return str(uuid.uuid5(uuid.NAMESPACE_URL, seed))


def fingerprint_files(files: list[sqlite3.Row]) -> str:
    digest = hashlib.sha256()

    for row in sorted(files, key=lambda r: r["relative_path"]):
        digest.update(str(row["relative_path"]).encode("utf-8", errors="ignore"))
        digest.update(str(row["sha256"]).encode("utf-8", errors="ignore"))

    return digest.hexdigest()


def path_has_ignored_parts(path: Path) -> bool:
    ignored = {
        ".git",
        ".venv",
        "venv",
        "site-packages",
        "__pycache__",
        ".idea",
        ".vscode",
        "node_modules",
    }
    return bool(set(path.parts) & ignored)


def safe_exists(path: Path) -> bool:
    try:
        return path.exists()
    except OSError:
        return False


def safe_is_dir(path: Path) -> bool:
    try:
        return path.is_dir()
    except OSError:
        return False


def safe_iterdir_names(path: Path) -> set[str]:
    try:
        if not path.is_dir():
            return set()
        return {child.name for child in path.iterdir()}
    except OSError:
        return set()


def safe_child_dirs(path: Path) -> set[str]:
    try:
        if not path.is_dir():
            return set()
        return {child.name.lower() for child in path.iterdir() if child.is_dir()}
    except OSError:
        return set()


def clean_object_name(path: Path) -> str:
    name = path.name

    if name.endswith(".html") or name.endswith(".htm"):
        name = Path(name).stem

    return name.replace("_", " ").replace("-", " ").strip() or path.name


def find_project_root(path: Path) -> ResourceGuess | None:
    current = path.parent if path.suffix else path

    while current != current.parent:
        names = safe_iterdir_names(current)

        marker = next((m for m in PROJECT_MARKERS if m in names), None)
        if marker:
            return ResourceGuess(
                object_path=current,
                object_name=clean_object_name(current),
                object_type_hint="codebase",
                primary_file_path=None,
                confidence=0.95,
                reason=f"resource detector: project marker {marker}",
            )

        current = current.parent

    return None


def find_website_root(path: Path) -> ResourceGuess | None:
    if path.suffix.lower() not in {".html", ".htm"}:
        return None

    current = path.parent
    best: ResourceGuess | None = None

    while current != current.parent:
        names = {name.lower() for name in safe_iterdir_names(current)}
        child_dirs = safe_child_dirs(current)

        has_index = bool(WEBSITE_MARKERS & names)
        has_assets = bool(COMMON_WEB_DIRS & child_dirs)

        if has_index:
            primary = None
            for marker in WEBSITE_MARKERS:
                candidate = current / marker
                if safe_exists(candidate):
                    primary = str(candidate)
                    break

            best = ResourceGuess(
                object_path=current,
                object_name=clean_object_name(current),
                object_type_hint="website_archive",
                primary_file_path=primary,
                confidence=0.96,
                reason="resource detector: website root with index page",
            )

        elif has_assets:
            best = ResourceGuess(
                object_path=current,
                object_name=clean_object_name(current),
                object_type_hint="website_archive",
                primary_file_path=None,
                confidence=0.88,
                reason="resource detector: website root with asset directories",
            )

        current_name = current.name.lower()

        if current_name in NAVIGATION_OR_FACET_DIRS:
            current = current.parent
            continue

        if best is not None and current_name not in NAVIGATION_OR_FACET_DIRS:
            return best

        current = current.parent

    return best


def detect_resource(row: sqlite3.Row) -> ResourceGuess:
    file_path = Path(row["file_path"])
    relative = Path(row["relative_path"])
    ext = file_path.suffix.lower()

    if ext in DOCUMENT_EXTENSIONS:
        return ResourceGuess(
            object_path=file_path,
            object_name=clean_object_name(file_path),
            object_type_hint="single_document",
            primary_file_path=str(file_path),
            confidence=0.90,
            reason=f"resource detector: standalone document {ext}",
        )

    website = find_website_root(file_path)
    if website is not None:
        return website

    project = find_project_root(file_path)
    if project is not None:
        return project

    if ext in IMAGE_EXTENSIONS:
        return ResourceGuess(
            object_path=file_path,
            object_name=clean_object_name(file_path),
            object_type_hint="single_image",
            primary_file_path=str(file_path),
            confidence=0.70,
            reason=f"resource detector: standalone image {ext}",
        )

    if ext in SOURCE_EXTENSIONS and len(relative.parts) > 1:
        return ResourceGuess(
            object_path=file_path.parent,
            object_name=clean_object_name(file_path.parent),
            object_type_hint="source_collection",
            primary_file_path=None,
            confidence=0.70,
            reason="resource detector: source file grouped by parent folder",
        )

    if len(relative.parts) > 1:
        return ResourceGuess(
            object_path=file_path.parent,
            object_name=clean_object_name(file_path.parent),
            object_type_hint=None,
            primary_file_path=None,
            confidence=0.60,
            reason="fallback: grouped by parent folder",
        )

    return ResourceGuess(
        object_path=file_path,
        object_name=clean_object_name(file_path),
        object_type_hint=None,
        primary_file_path=str(file_path),
        confidence=0.50,
        reason="fallback: single loose file",
    )


def detect_object_type(
    object_path: Path,
    files: list[sqlite3.Row],
    hint: ResourceGuess | None = None,
) -> tuple[str, float, str, str | None]:
    names = {Path(row["file_path"]).name for row in files}
    suffixes = {Path(row["file_path"]).suffix.lower() for row in files}
    parts = set(object_path.parts)

    if hint and hint.object_type_hint:
        primary = hint.primary_file_path

        if primary is None and hint.object_type_hint == "website_archive":
            primary = next(
                (
                    row["file_path"]
                    for row in files
                    if Path(row["file_path"]).name.lower() in WEBSITE_MARKERS
                ),
                None,
            )

        return (
            hint.object_type_hint,
            hint.confidence,
            hint.reason,
            primary,
        )

    if ".git" in names or ".git" in parts:
        return "git_repository", 0.98, "contains .git marker", None

    if {"pyproject.toml", "setup.py", "requirements.txt"} & names:
        return "python_project", 0.92, "contains Python project marker", None

    if "package.json" in names:
        return "node_project", 0.90, "contains Node project marker", None

    if {"content.opf", "toc.ncx"} & names:
        primary = next((row["file_path"] for row in files if Path(row["file_path"]).name == "content.opf"), None)
        return "epub_extracted_book", 0.95, "contains EPUB metadata marker", primary

    if {"index.html", "index.htm"} & names and ({".css", ".js"} & suffixes):
        primary = next(
            (row["file_path"] for row in files if Path(row["file_path"]).name.lower() in WEBSITE_MARKERS),
            None,
        )
        return "website_archive", 0.90, "contains index page plus web assets", primary

    if any("Project" in part or "project" in part for part in object_path.parts):
        return "academic_or_code_project", 0.70, "path name suggests project", None

    if len(files) == 1:
        row = files[0]
        ext = Path(row["file_path"]).suffix.lower()

        if ext in DOCUMENT_EXTENSIONS:
            return "single_document", 0.80, f"single supported document {ext}", row["file_path"]

        if ext in IMAGE_EXTENSIONS:
            return "single_image", 0.70, f"single image {ext}", row["file_path"]

        return "single_file", 0.50, "single loose file", row["file_path"]

    if suffixes <= WEB_EXTENSIONS:
        return "web_or_html_collection", 0.75, "directory contains mostly web assets", None

    return "folder_collection", 0.60, "directory grouped as folder collection", None


def load_discovered_files(
    conn: sqlite3.Connection,
    root_filter: str | None,
) -> list[sqlite3.Row]:
    sql = """
        SELECT
            id,
            file_path,
            root_path,
            relative_path,
            filename,
            extension,
            size_bytes,
            sha256,
            category,
            status
        FROM discovered_files
    """
    params: list[str] = []

    if root_filter:
        sql += " WHERE file_path LIKE ?"
        params.append(f"%{root_filter}%")

    sql += " ORDER BY file_path"

    return list(conn.execute(sql, params))


def build_objects(
    db_path: str,
    root_filter: str | None = None,
    dry_run: bool = False,
) -> dict[str, int]:
    db = Path(db_path).expanduser().resolve()

    counts: dict[str, int] = {
        "files_seen": 0,
        "files_grouped": 0,
        "objects_built": 0,
        "ignored_files": 0,
        "errors": 0,
    }

    with sqlite3.connect(db) as conn:
        conn.row_factory = sqlite3.Row
        init_db(conn)

        rows = load_discovered_files(conn, root_filter)
        counts["files_seen"] = len(rows)

        grouped: dict[Path, list[sqlite3.Row]] = defaultdict(list)
        hints: dict[Path, ResourceGuess] = {}

        for row in rows:
            path = Path(row["file_path"])

            if row["status"] == "ignored" or path_has_ignored_parts(path):
                counts["ignored_files"] += 1
                continue

            try:
                guess = detect_resource(row)
                grouped[guess.object_path].append(row)

                existing = hints.get(guess.object_path)
                if existing is None or guess.confidence > existing.confidence:
                    hints[guess.object_path] = guess

                counts["files_grouped"] += 1

            except Exception as exc:
                counts["errors"] += 1
                print(f"[WARN] Failed grouping {row['file_path']}: {exc}")

        if dry_run:
            print(f"[DRY-RUN] Would build {len(grouped)} knowledge objects.")
            counts["objects_built"] = len(grouped)
            for key, files in sorted(grouped.items(), key=lambda item: str(item[0]))[:50]:
                hint = hints.get(key)
                kind = hint.object_type_hint if hint else "unknown"
                print(f"[DRY-RUN] {kind}: {key} ({len(files)} files)")
            return counts

        for object_path, files in grouped.items():
            try:
                root_path = files[0]["root_path"]
                total_size = sum(int(row["size_bytes"]) for row in files)
                fingerprint = fingerprint_files(files)
                object_uuid = stable_uuid(str(object_path), fingerprint)
                hint = hints.get(object_path)

                object_type, confidence, reason, primary_file = detect_object_type(
                    object_path=object_path,
                    files=files,
                    hint=hint,
                )

                object_name = hint.object_name if hint else clean_object_name(object_path)

                obj = KnowledgeObject(
                    object_uuid=object_uuid,
                    root_path=root_path,
                    object_path=str(object_path),
                    object_name=object_name,
                    object_type=object_type,
                    primary_file_path=primary_file,
                    file_count=len(files),
                    total_size_bytes=total_size,
                    content_fingerprint=fingerprint,
                    status="registered",
                    confidence=confidence,
                    reason=reason,
                )

                conn.execute(
                    """
                    INSERT INTO knowledge_objects (
                        object_uuid,
                        root_path,
                        object_path,
                        object_name,
                        object_type,
                        primary_file_path,
                        file_count,
                        total_size_bytes,
                        content_fingerprint,
                        status,
                        confidence,
                        reason
                    )
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    ON CONFLICT(object_path) DO UPDATE SET
                        object_uuid = excluded.object_uuid,
                        object_name = excluded.object_name,
                        object_type = excluded.object_type,
                        primary_file_path = excluded.primary_file_path,
                        file_count = excluded.file_count,
                        total_size_bytes = excluded.total_size_bytes,
                        content_fingerprint = excluded.content_fingerprint,
                        status = excluded.status,
                        confidence = excluded.confidence,
                        reason = excluded.reason,
                        updated_at = CURRENT_TIMESTAMP
                    """,
                    (
                        obj.object_uuid,
                        obj.root_path,
                        obj.object_path,
                        obj.object_name,
                        obj.object_type,
                        obj.primary_file_path,
                        obj.file_count,
                        obj.total_size_bytes,
                        obj.content_fingerprint,
                        obj.status,
                        obj.confidence,
                        obj.reason,
                    ),
                )

                for row in files:
                    role = "primary" if row["file_path"] == primary_file else "member"

                    conn.execute(
                        """
                        INSERT INTO knowledge_object_files (
                            object_uuid,
                            discovered_file_id,
                            file_path,
                            role
                        )
                        VALUES (?, ?, ?, ?)
                        ON CONFLICT(file_path) DO UPDATE SET
                            object_uuid = excluded.object_uuid,
                            discovered_file_id = excluded.discovered_file_id,
                            role = excluded.role
                        """,
                        (
                            obj.object_uuid,
                            row["id"],
                            row["file_path"],
                            role,
                        ),
                    )

                counts["objects_built"] += 1
                counts[obj.object_type] = counts.get(obj.object_type, 0) + 1

                if counts["objects_built"] % 500 == 0:
                    conn.commit()
                    print(f"[INFO] objects_built={counts['objects_built']}")

            except Exception as exc:
                counts["errors"] += 1
                print(f"[WARN] Failed object build for {object_path}: {exc}")

        conn.commit()

    return counts
