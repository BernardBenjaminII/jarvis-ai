{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/academy/department.schema.json",
  "title": "Department",
  "type": "object",
  "required": ["id", "name", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["planned", "dormant", "active", "restricted", "retired"]
    }
  },
  "additionalProperties": true
}
