#!/usr/bin/env bash
set -euo pipefail

###############################################################################
# JARVIS Runtime
###############################################################################

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

JARVIS_RUNTIME="${JARVIS_RUNTIME:-/media/abdullah/JARVIS_RUNTIME_L}"

JARVIS_DB="${JARVIS_DB:-$JARVIS_RUNTIME/knowledge/catalog.sqlite}"

JARVIS_PY="${JARVIS_PY:-$JARVIS_RUNTIME/venvs/ubuntu/bin/python}"

###############################################################################
# Usage
###############################################################################

usage() {

cat <<EOF

JARVIS

Usage

    ./jarvis <command> [arguments]

Commands

    doctor
    capability
    workflow
    graph
    assimilate

EOF

}

[[ $# -ge 1 ]] || {
    usage
    exit 1
}

COMMAND="$1"
shift

###############################################################################
# Dispatcher
###############################################################################

case "$COMMAND" in

###############################################################################
# Doctor
###############################################################################

doctor)

    exec "$JARVIS_PY" \
        -m knowledge_engine.doctor_cli \
        --db "$JARVIS_DB" \
        "$@"

;;

###############################################################################
# Capability Runtime
###############################################################################

capability)

    exec "$JARVIS_PY" \
        -m core.capability_runtime_cli \
        "$@"

;;

###############################################################################
# Workflow Engine
###############################################################################

workflow)

    exec "$JARVIS_PY" \
        -m knowledge_engine.workflow_cli \
        "$@" \
        --db "$JARVIS_DB"

;;

###############################################################################
# Knowledge Graph
###############################################################################

graph)

    exec "$JARVIS_PY" \
        -m knowledge_engine.knowledge_graph_cli \
        "$@" \
        --db "$JARVIS_DB"

;;

###############################################################################
# Assimilation Pipeline
###############################################################################

assimilate)

    exec "$JARVIS_PY" \
        -m knowledge_engine.mass_assimilation_cli \
        "$@" \
        --db "$JARVIS_DB"

;;

###############################################################################

*)

    echo
    echo "Unknown command: $COMMAND"
    echo
    usage
    exit 1

;;

esac
